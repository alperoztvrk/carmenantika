# Stripe gizli anahtarı.
# Stripe Dashboard → Developers → API keys → Secret key
# Test ödemesi için sk_test_ ile başlayan anahtar.
# Canlı tahsilat için sk_live_ ile başlayan anahtar.
STRIPE_SECRET_KEY=

# İsteğe bağlı. Webhook imzası (whsec_...).
# Yerelde başarı sayfası ödemeyi Stripe’tan doğrular; bu satır olmadan da ödeme tamamlanır.
STRIPE_WEBHOOK_SECRET=
