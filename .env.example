# iyzico — Türk lirası tahsilatı.
# Sandbox anahtarları: https://sandbox-merchant.iyzipay.com → Ayarlar → API Anahtarları
# Canlı anahtarlar: https://merchant.iyzipay.com
# Anahtarları bu dosyaya değil, yanındaki .env dosyasına yaz. Sunucuyu yeniden başlat.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Boş bırakılırsa sandbox kullanılır.
# Canlı tahsilat için: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
