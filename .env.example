# Bu dosyayı kopyalama. Yanına .env oluşturup değerleri oraya yaz.
# Tırnak kullanma. Kaydedince sunucuyu yeniden başlat.

# Yönetim (/admin) — carmen kullanma
LOCAL_ADMIN_PASSWORD=buraya-kendi-sifren

# Oturum imzası (en az 24 karakter). Üretmek için: openssl rand -hex 32
JWT_SECRET=

# Canlı domain. iyzico geri dönüş adresi bundan üretilir. https zorunlu.
SITE_URL=https://senin-domainin.com

# iyzico canlı tahsilat
# 1. https://merchant.iyzipay.com giriş
# 2. Ayarlar → Firma Ayarları → API Anahtarları → Görüntüle
# 3. API Anahtarı → IYZICO_API_KEY
# 4. Güvenlik Anahtarı → IYZICO_SECRET_KEY
# Anahtarlar sandbox- ile başlamamalı. Eski sandbox satırlarını sil.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Sadece kendi bilgisayarında sahte kart denemek için (canlı sitede kullanma):
# https://sandbox-merchant.iyzipay.com
# IYZICO_API_KEY=sandbox-...
# IYZICO_SECRET_KEY=sandbox-...
